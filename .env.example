API_ID=
API_HASH=
PHONE_NUMBER=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tg_message_collector
MYSQL_USER=tg_collector
MYSQL_PASSWORD=
MYSQL_READ_USER=tg_reader
MYSQL_READ_PASSWORD=
MCP_PORT=8765
MCP_TOKEN=
# Empty = all accessible groups/channels; private chats are excluded even if listed explicitly.
CHAT_IDS=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Initial provider; cloudflare is selected only by the verified activation command.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_DIM=384
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Explicit consent required for archive texts AND semantic queries sent to Cloudflare.
CF_ALLOW_REAL_MESSAGES=false
CF_BATCH_SIZE=16
CF_REQUESTS_PER_MINUTE=60
# Local conservative estimate shared by processes on this host, NOT account billing.
CF_DAILY_NEURON_BUDGET=9000
CF_NEURONS_PER_MILLION_TOKENS=1075

# Disable only model/index work while a separate migration job runs; Telegram collection stays online.
EMBEDDING_WORKER_ENABLED=true
